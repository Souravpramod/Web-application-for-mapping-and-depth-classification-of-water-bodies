# Google Places API key used for lake-name lookup. Rotate the exposed key before setting this.
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key

# Optional overrides; defaults point to the bundled models/ files.
YOLO_MODEL_PATH=models/water_segmentation.pt
DEPTH_MODEL_PATH=models/depth_classifier.h5
SCALER_PATH=models/scaler.pkl
ENCODER_PATH=models/encoder.pkl
